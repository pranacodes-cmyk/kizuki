<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: pure black with the fox face at the size the in-app
         animated splash starts from (112dp of the 288dp icon canvas), so the hand-off is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/mimi_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:statusBarColor">@color/mimi_background</item>
        <item name="android:navigationBarColor">@color/mimi_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/mimi_background</item>
    </style>
</resources>
