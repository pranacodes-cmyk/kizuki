<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🦊 kizuki" android:textColor="@color/widget_primary" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_word" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="気づき" android:textColor="@color/widget_foreground" android:textSize="38sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/widget_reading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_meaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_foreground" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_review" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="12sp" />
        <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>