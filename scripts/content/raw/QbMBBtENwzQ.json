    "comedy"
   ],
   "grammar": [
    "〜てみる — try doing / experience",
    "〜たことある — have experienced doing"
   ],
   "quality": 5,
   "lines": [
    {
     "start": 7.102,
     "end": 7.12,
     "ja": "じゃ、まず何階建てがいいとかっていうのは…",
     "en": "Well then, first, how many stories would you like...",
     "speaker": "Architect"
    },
    {
     "start": 7.12,
     "end": 7.136,
     "ja": "あ、いや、それは決まってます。2階建て。",
     "en": "Ah, no, that's already decided. Two stories.",
     "speaker": "Customer"
    },
    {
     "start": 7.136,
     "end": 7.147,
     "ja": "地下2階建てで…",
     "en": "Two stories underground...",
     "speaker": "Architect"
    },
    {
     "start": 7.147,
     "end": 7.158,
     "ja": "地上だよ！",
     "en": "Above ground!",
     "speaker": "Customer"
    },
    {
     "start": 7.158,
     "end": 7.164,
     "ja": "地上…",
     "en": "Above ground...",
     "speaker": "Architect"
    },
    {
     "start": 7.164,
     "end": 7.194,
     "ja": "見たことあります？見た目更地で地下2階建て。",
     "en": "Have you ever seen that? Looks like an empty lot, but two stories underground.",
     "speaker": "Customer"
    },
    {
     "start": 7.194,
     "end": 7.21,
     "ja": "いや、ここあんだよ、俺んち！",
     "en": "Like: 'Hey, my house is right here!'",
     "speaker": "Customer"
    },
    {
     "start": 7.21,
     "end": 7.244,
     "ja": "俺んちここ…いや、あるんだって！",
     "en": "'My house is here... no, seriously, it is!'",
     "speaker": "Customer"
    },
    {
     "start": 7.244,
     "end": 7.258,
     "ja": "そんな家あります？",
     "en": "Does a house like that even exist?",
     "speaker": "Customer"
    },
    {
     "start": 7.258,
     "end": 7.278,
     "ja": "見たことないですね。",
     "en": "I've never seen one.",
     "speaker": "Architect"
    },
    {
     "start": 7.278,
     "end": 7.298,
     "ja": "間違ってなんか建つわ、お前！",
     "en": "Someone would accidentally build on top of it, man!",
     "speaker": "Customer"
    },
    {
     "start": 7.298,
     "end": 7.309,
     "ja": "地上…地上ですか。",
     "en": "Above... above ground, then.",
     "speaker": "Architect"
    },
    {
     "start": 7.309,
     "end": 7.32,
     "ja": "地上ですよ！",
     "en": "Above ground, obviously!",
     "speaker": "Customer"
    },
    {
     "start": 7.32,
     "end": 7.328,
     "ja": "地上2階建てですね。",
     "en": "Two stories above ground.",
     "speaker": "Architect"
    },
    {
     "start": 7.328,
     "end": 7.348,
     "ja": "当たり前でしょ！何すか、地下2階建てって。",
     "en": "Of course! What's with 'two stories underground'?!",
     "speaker": "Customer"
    },
    {
     "start": 7.348,
     "end": 7.357,
     "ja": "地上の2階建て。",
     "en": "Two stories above ground.",
     "speaker": "Architect"
    },
    {
     "start": 7.357,
