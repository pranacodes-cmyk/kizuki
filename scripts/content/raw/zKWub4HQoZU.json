     "start": 40.0,
     "end": 40.5,
     "ja": "うん。",
     "en": "Yeah.",
     "speaker": "Inada"
    },
    {
     "start": 40.5,
     "end": 42.3,
     "ja": "最後に何食べたいかなと思いましてね。",
     "en": "I was wondering what you'd want to eat last.",
     "speaker": "Kumamoto"
    },
    {
     "start": 42.3,
     "end": 43.7,
     "ja": "あ、最後の晩餐ってことですか？",
     "en": "Ah, like a last supper?",
     "speaker": "Inada"
    },
    {
     "start": 43.7,
     "end": 44.8,
     "ja": "あ、そうそう。",
     "en": "Ah, exactly.",
     "speaker": "Kumamoto"
    },
    {
     "start": 44.8,
     "end": 46.3,
     "ja": "今までね、聞いたことなかった。",
     "en": "I've never asked you before.",
     "speaker": "Kumamoto"
    },
    {
     "start": 46.3,
     "end": 47.3,
     "ja": "ああ、まあ確かにね。",
     "en": "Ah, well, that's true.",
     "speaker": "Inada"
    },
    {
