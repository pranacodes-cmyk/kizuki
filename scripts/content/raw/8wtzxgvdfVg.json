    {
     "start": 5.0,
     "end": 8.0,
     "ja": "みんなが年齢を当てることができるのかやってみたいと思います。",
     "en": "I want to see if everyone can guess their ages.",
     "speaker": "Kaito"
    },
    {
     "start": 8.0,
     "end": 11.0,
     "ja": "自分の周りの海外の友達は、日本に長くいたり、",
     "en": "My foreign friends around me have lived in Japan for a long time,",
     "speaker": "Kaito"
    },
    {
     "start": 11.0,
     "end": 12.5,
     "ja": "結構日本のテレビ見たり、",
     "en": "watch quite a bit of Japanese TV,",
     "speaker": "Kaito"
    },
    {
     "start": 12.5,
     "end": 14.3,
     "ja": "なんといっても捻くれ者が多いので、",
     "en": "and above all, many are contrarians,",
