    },
    {
     "start": 14.3,
     "end": 16.4,
     "ja": "みんな本気で予想してくると思うの。",
     "en": "so I think they'll make serious guesses.",
     "speaker": "Kaito"
    },
    {
     "start": 16.4,
     "end": 18.5,
     "ja": "そんな日本のことよく知ってる人でも、",
     "en": "Even for people who know Japan so well,",
     "speaker": "Kaito"
    },
    {
     "start": 18.5,
     "end": 21.8,
     "ja": "日本人の年齢を当てるのは難しいのか検証していきたいと思います。",
     "en": "I'd like to test if guessing Japanese people's age is difficult.",
     "speaker": "Kaito"
    }
